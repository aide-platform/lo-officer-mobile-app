<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The app talks to the API gateway over https://
     (GCP: aeroindia.evenuefy.com, NIC: aeroindia.gov.in). No cleartext
     exceptions: the old raw-IP HTTP allowlist was removed for VAPT LOA-02. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
