<?xml version="1.0" encoding="utf-8"?>
<!-- CAP API is currently HTTP (http://35.244.48.209:8080). Android blocks
     cleartext in release unless explicitly allowed. Only the live CAP host
     is allowlisted — localhost / emulator aliases are omitted from release. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">35.244.48.209</domain>
    </domain-config>
</network-security-config>
